.DS_Store
*.swp
*.bak
# .claude/* rather than .claude/: git cannot re-include a file whose parent
# DIRECTORY is excluded, so the negation below only works against a glob.
.claude/*
# The graphify PostToolUse hook config is project setup, not local state.
!.claude/settings.json
.rendered/
.gstack/

# hive worktrees
.worktrees

# plan-html review artifacts (generated by /hs-plan-html)
.plans/

# graphify build artifacts
graphify-out/

# Python bytecode (scripts/regen-generated.py, scripts/migrate-to-changesets.py)
__pycache__/
*.pyc
